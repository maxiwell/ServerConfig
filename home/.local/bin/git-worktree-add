#!/bin/bash

wt_path="${@: -1}"

worktree_name=$(basename "$wt_path")

# Se já existir uma branch com esse nome, usa ela no worktree; senão deixa o git criar uma nova
if git show-ref --verify --quiet "refs/heads/$worktree_name"; then
    git worktree add worktree/$worktree_name $worktree_name
else
    git worktree add worktree/$worktree_name
fi
cd worktree/$worktree_name
cd config && ln -s ../../../config/devel && cd -

# .claude não é versionado; sem esse symlink os skills/CLAUDE.md não carregam no worktree
[ -e .claude ] || ln -s ../../.claude .claude
./scripts/deploy.sh

WT_ABS="$PWD"

# Registra o worktree como workspace no herdr pra aparecer no menu lateral
if command -v herdr >/dev/null 2>&1; then
    herdr worktree open --cwd "$WT_ABS" --path "$WT_ABS" --no-focus >/dev/null \
        || echo "Falha ao abrir no herdr; rode: herdr worktree open --path $WT_ABS"
fi

# O remote-cli do VSCode precisa do socket IPC; fora de um terminal do VSCode ele costuma estar ausente/vencido
if [ -z "$VSCODE_IPC_HOOK_CLI" ] || [ ! -S "$VSCODE_IPC_HOOK_CLI" ]; then
    export VSCODE_IPC_HOOK_CLI=$(ls -t /run/user/$(id -u)/vscode-ipc-*.sock 2>/dev/null | head -1)
fi

if command -v code >/dev/null 2>&1 && [ -n "$VSCODE_IPC_HOOK_CLI" ]; then
    code -n "$WT_ABS"
else
    echo "VSCode CLI indisponível; abra manualmente: code -n $WT_ABS"
fi
